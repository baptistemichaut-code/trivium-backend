  "intermediate": {
    "themeTitle": "Miroirs et Vertiges",
    "themeSubtitle": "Explorer les failles invisibles de l'identité et le doute d'être soi.",
    "items": [
      {
        "type": "LIVRE",
        "title": "Fictions",
        "creator": "Jorge Luis Borges",
        "year": "1944",
        "origin": "Argentine",
        "genre": "Nouvelles fantastiques",
        "accessibility": "Curieux",
        "formatMetric": "220 pages",
        "quote": "J'ai soupçonné que l'histoire humaine est l'histoire de quelques métaphores.",
        "anecdote": "Atteint d'une cécité progressive, Borges imaginait ses labyrinthes et ses bibliothèques infinies avant de les dicter à sa mère ou ses amis.",
        "tags": [
          "Labyrinthe",
          "Philosophie"
        ],
        "ratings": [
          {
            "source": "Le Monde des Livres",
            "score": "5/5",
            "iconName": "star.fill",
            "excerpt": "Un monument d'érudition et d'imagination pure."
          },
          {
            "source": "Télérama",
            "score": "4.5/5",
            "iconName": "star.fill",
            "excerpt": "Une expérience intellectuelle jubilatoire où la littérature se contemple elle-même."
          },
          {
            "source": "The Guardian",
            "score": "5/5",
            "iconName": "star.fill",
            "excerpt": "L'un des recueils de nouvelles les plus influents de la littérature moderne."
          }
